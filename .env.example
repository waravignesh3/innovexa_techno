# MongoDB URI - Replace with your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Admin panel password for backend
ADMIN_PANEL_PASSWORD=innovex@admin

# GitHub API Token (optional - for accessing private repos and higher API rate limits)
GITHUB_ACCESS_TOKEN=

# Alternative GitHub token variable name
GITHUB_TOKEN=

# Server port
PORT=3000

# Environment
NODE_ENV=production
